import paho.mqtt.client as mqtt
import json
import time
import random
import base64
import struct

# Configuration
BROKER = "localhost"
# Use your specific App/Device IDs
APP_ID = "0a941c62-ac27-44d5-877b-8160436aaaa3" 
DEV_EUI = "1096630fc0013d99" 

# Initialize MQTT Client
client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
client.connect(BROKER, 1883, 60)
client.loop_start()

def create_chirpstack_payload(temp, batt, version=1):
    temp_int = int(temp * 100)
    batt_int = int(batt * 100)
    
    # '>' = Big Endian
    # 'h' = Temp (2 bytes)
    # 'H' = Battery (2 bytes)
    # 'H' = Version (2 bytes) - Now supports up to 65,535
    raw_binary = struct.pack(">hHH", temp_int, batt_int, version)
    return base64.b64encode(raw_binary).decode('utf-8')

print("Starting Mock ChirpStack Stream...")

try:
    while True:
        # Generate data
        temp = random.uniform(15.0, 35.0)
        batt = random.uniform(3.0, 4.2)
        version = random.randint(1, 9)
        
        # Create payload structure
        payload = {
            "deviceInfo": {
                "deviceName": "Stack01",
                "devEui": DEV_EUI
            },
            "data": create_chirpstack_payload(temp, batt, version),
            "fPort": 1
        }
        
        # Publish to ChirpStack V4 topic
        topic = f"application/{APP_ID}/device/{DEV_EUI}/event/up"
        client.publish(topic, json.dumps(payload))
        
        print(f"Sent: {temp:.2f}°C, {batt:.2f}V, Version: {version} | Base64: {payload['data']}")
        
        time.sleep(5)
except KeyboardInterrupt:
    print("Stopping mock stream...")
    client.loop_stop()
    client.disconnect()